{
  "compilerOptions": {
    "target": "ES2023", "module": "CommonJS", "moduleResolution": "Node",
    "outDir": "dist", "rootDir": ".", "strict": true,
    "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "esModuleInterop": true, "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true, "sourceMap": true
  },
  "include": ["apps/**/*.ts", "modules/**/*.ts", "packages/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
