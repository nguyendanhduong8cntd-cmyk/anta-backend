FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/python_backend
WORKDIR /app
COPY python_backend/requirements.txt /app/python_backend/requirements.txt
RUN pip install --no-cache-dir -r /app/python_backend/requirements.txt
COPY python_backend/anta_api /app/python_backend/anta_api
COPY migrations /app/migrations
USER 65532:65532
EXPOSE 8000
CMD ["uvicorn", "anta_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
