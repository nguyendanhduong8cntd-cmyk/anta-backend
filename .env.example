# Local only: replace all credentials before using a shared environment.
NODE_ENV=development
DATABASE_URL=postgresql://alobo:alobo_local@127.0.0.1:55432/alobo
REDIS_URL=redis://127.0.0.1:56379
JWT_SECRET=local-only-replace-with-at-least-32-random-characters
OTP_HASH_SECRET=local-only-otp-key-replace-with-32-random-characters
SANDBOX_WEBHOOK_SECRET=local-only-webhook-key-replace-with-32-characters
PORT=3000
REALTIME_PORT=3001
BIND_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000
PAYMENT_PROVIDER=sandbox
OTP_DELIVERY=development
# Required to retrieve local OTP at an explicit development-only endpoint.
DEV_OTP_ENABLED=false
DEV_ADMIN_KEY=
# FCM: set GOOGLE_APPLICATION_CREDENTIALS to a service-account file outside Git.
FCM_ENABLED=false
# Optional verified Google login: both values required; service account stays outside Git.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Cloudflare R2 court images. Use a new bucket-scoped Object Read & Write key pair.
# Never paste the API token value or secret into Git, Android, logs, or chat.
R2_ACCOUNT_ID=14e93d6b9a126b668de5fb3c693ffb8b
R2_BUCKET=alobo-court-images
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Leave blank for the default endpoint; set only for EU/US/FedRAMP jurisdiction buckets.
R2_ENDPOINT=

# ---- Payment provider: sandbox | payos | vnpay. Production refuses sandbox. ----
# PAYMENT_RETURN_URL is where the provider sends the user back (app deep link or web page). It never confirms a payment.
PAYMENT_RETURN_URL=
PAYMENT_CANCEL_URL=
# PayOS (https://my.payos.vn): register webhook URL https://<host>/api/v1/webhooks/payments/payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# VNPay: register IPN URL https://<host>/api/v1/webhooks/payments/vnpay/ipn. Defaults point at the VNPay sandbox.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=
VNPAY_API_URL=
# ---- OTP delivery: development | provider. With "provider", email identifiers use SMTP and phone numbers use Twilio. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender number in E.164, or a Messaging Service SID (MG...).
TWILIO_FROM=
# ---- Refund policy for user cancellations (hours before the slot starts) ----
REFUND_FULL_HOURS=24
REFUND_PARTIAL_HOURS=2
REFUND_PARTIAL_PERCENT=50
REFUND_ORDER_HOURS=24
# Erase personal data 30 days after an account deletion request. Set false to keep requests pending.
ACCOUNT_PURGE_ENABLED=true
# ---- Only for `npm run test:live` ----
FIREBASE_WEB_API_KEY=
LIVE_TEST_GOOGLE_ID_TOKEN=
LIVE_TEST_EMAIL=
LIVE_TEST_PHONE=
